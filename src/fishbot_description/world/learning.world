<?xml version="1.0"?>
<sdf version="1.6">

  <world name="learning_world">

    <!-- 复用 Gazebo 提供的地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 复用 Gazebo 提供的光源 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 小车前方的墙 -->
    <model name="front_wall">
      <static>true</static>

      <!-- x y z roll pitch yaw -->
      <pose>1.0 0 0.5 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.10 2.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.10 2.0 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>

      </link>
    </model>
<model name="side_wall">
  <static>true</static>
  <pose>0 1.5 0.5 0 0 0</pose>

  <link name="wall_link">
    <collision name="collision">
      <geometry>
        <box><size>4.0 0.1 1.0</size></box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box><size>4.0 0.1 1.0</size></box>
      </geometry>
    </visual>
  </link>
</model>
<model name="back_wall">
  <static>true</static>
  <pose>-2.0 0 0.5 0 0 0</pose>

  <link name="wall_link">
    <collision name="collision">
      <geometry>
        <box><size>0.1 3.0 1.0</size></box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box><size>0.1 3.0 1.0</size></box>
      </geometry>
    </visual>
  </link>
</model>
  </world>

</sdf>