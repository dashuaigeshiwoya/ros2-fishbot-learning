<?xml version="1.0"?>
<robot name="fishbot">

  <!-- 地面参考系 -->
  <link name="base_footprint"/>

  <!-- 车体 -->
<link name="base_link">

  <!-- 显示外观 -->
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>

    <geometry>
      <cylinder radius="0.10" length="0.12"/>
    </geometry>

    <material name="blue">
      <color rgba="0.1 0.1 1.0 1.0"/>
    </material>
  </visual>

  <!-- 接触判断所用的外形 -->
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>

    <geometry>
      <cylinder radius="0.10" length="0.12"/>
    </geometry>
  </collision>
<inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>

  <mass value="1.0"/>

  <inertia
    ixx="0.0037"
    ixy="0.0"
    ixz="0.0"
    iyy="0.0037"
    iyz="0.0"
    izz="0.005"/>
</inertial>
</link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.076" rpy="0 0 0"/>
  </joint>

  <!-- 左轮 -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
 <collision>
  <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
   <geometry>
    <cylinder radius="0.032" length="0.04"/>
   </geometry>
  </collision>
  <inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>

  <mass value="0.10"/>

  <inertia
    ixx="0.0000389333"
    ixy="0.0"
    ixz="0.0"
    iyy="0.0000512"
    iyz="0.0"
    izz="0.0000389333"/>
</inertial>
</link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="-0.02 0.10 -0.044" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 右轮 -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
     <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>

     <geometry>
     <cylinder radius="0.032" length="0.04"/>
     </geometry>
    </collision>
    <inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>

  <mass value="0.10"/>

  <inertia
    ixx="0.0000389333"
    ixy="0.0"
    ixz="0.0"
    iyy="0.0000512"
    iyz="0.0"
    izz="0.0000389333"/>
  </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="-0.02 -0.10 -0.044" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 球形支撑轮 -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.016"/>
      </geometry>
      <material name="black"/>
    </visual>
   <collision>
  <origin xyz="0 0 0" rpy="0 0 0"/>

    <geometry>
     <sphere radius="0.016"/>
    </geometry>
   </collision>
   <inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <mass value="0.05"/>

  <inertia
    ixx="0.00000512"
    ixy="0.0"
    ixz="0.0"
    iyy="0.00000512"
    iyz="0.0"
    izz="0.00000512"/>
</inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.06 0 -0.060" rpy="0 0 0"/>
  </joint>

  <!-- 激光雷达 -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>

    <geometry>
     <cylinder radius="0.02" length="0.02"/>
    </geometry>
    </collision>
    <inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <mass value="0.10"/>

  <inertia
    ixx="0.0000133333"
    ixy="0.0"
    ixz="0.0"
    iyy="0.0000133333"
    iyz="0.0"
    izz="0.00002"/>
</inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <mass value="0.01"/>

  <inertia
    ixx="0.000000666667"
    ixy="0.0"
    ixz="0.0"
    iyy="0.000000666667"
    iyz="0.0"
    izz="0.000000666667"/>
</inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  <gazebo reference="base_link">
  <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="left_wheel_link">
  <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_wheel_link">
  <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="laser_link">
  <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="imu_link">
  <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="caster_link">
  <material>Gazebo/Black</material>
  </gazebo>
  <!-- 差速驱动插件 -->
<gazebo>
  <plugin
    name="fishbot_diff_drive"
    filename="libgazebo_ros_diff_drive.so">

    <ros>
      <namespace>/</namespace>
      <remapping>cmd_vel:=cmd_vel</remapping>
    </ros>

    <update_rate>50</update_rate>

    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>

    <wheel_separation>0.20</wheel_separation>
    <wheel_diameter>0.064</wheel_diameter>

    <max_wheel_torque>5.0</max_wheel_torque>
    <max_wheel_acceleration>1.0</max_wheel_acceleration>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>false</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>

  </plugin>
</gazebo>
<!-- 简化支撑球与地面之间的摩擦 -->
<gazebo reference="caster_link">
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
</gazebo>

<!-- 发布 Gazebo 中实际的轮子关节状态 -->
<gazebo>
  <plugin
    name="fishbot_joint_states"
    filename="libgazebo_ros_joint_state_publisher.so">

    <ros>
      <namespace>/</namespace>
    </ros>

    <update_rate>50</update_rate>

    <joint_name>left_wheel_joint</joint_name>
    <joint_name>right_wheel_joint</joint_name>

  </plugin>
</gazebo>
<!-- 安装在 laser_link 上的二维测距传感器 -->
<gazebo reference="laser_link">

  <sensor name="fishbot_laser" type="ray">

    <pose>0 0 0 0 0 0</pose>

    <always_on>true</always_on>
    <update_rate>10</update_rate>
    <visualize>false</visualize>

    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159265359</min_angle>
          <max_angle>3.14159265359</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.12</min>
        <max>8.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>

    <!-- 将 Gazebo 测量结果发布为 ROS2 消息 -->
    <plugin
      name="fishbot_laser_ros"
      filename="libgazebo_ros_ray_sensor.so">

      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=scan</remapping>
      </ros>

      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>laser_link</frame_name>

    </plugin>

  </sensor>

</gazebo>


<!-- IMU 仿真传感器 -->
<gazebo reference="imu_link">
  <sensor name="fishbot_imu" type="imu">
    <pose>0 0 0 0 0 0</pose>
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>false</visualize>

    <plugin name="fishbot_imu_ros"
            filename="libgazebo_ros_imu_sensor.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=imu</remapping>
      </ros>

      <frame_name>imu_link</frame_name>
      <initial_orientation_as_reference>false</initial_orientation_as_reference>
    </plugin>
  </sensor>
</gazebo>
</robot>